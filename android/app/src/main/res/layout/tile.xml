<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="176dp" android:layout_height="99dp" android:background="@drawable/tile" android:padding="4dp">
    <ImageView android:id="@+id/image" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter" android:paddingBottom="20dp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:gravity="center" android:textColor="#FFFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
</FrameLayout>
