<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/wallpaper" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingLeft="48dp" android:paddingRight="48dp" android:paddingTop="27dp" android:paddingBottom="27dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold" android:shadowColor="#CC000000" android:shadowRadius="6" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/network" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="14sp" android:shadowColor="#CC000000" android:shadowRadius="6" android:layout_marginRight="20dp" />
            <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="HH:mm" android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF" android:textSize="24sp" android:shadowColor="#CC000000" android:shadowRadius="6" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/warning" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#CCB3261E" android:textColor="#FFFFFFFF" android:textSize="13sp" android:padding="8dp" android:layout_marginBottom="8dp" android:visibility="gone" />
        <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/no_apps" android:textColor="#FFFFFFFF" android:textSize="15sp" android:shadowColor="#CC000000" android:shadowRadius="6" android:layout_marginBottom="8dp" android:visibility="gone" />
        <GridView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnWidth="176dp" android:numColumns="auto_fit" android:stretchMode="none"
            android:horizontalSpacing="14dp" android:verticalSpacing="14dp" android:clipToPadding="false"
            android:listSelector="@android:color/transparent" android:drawSelectorOnTop="false"
            android:scrollbars="none" android:nextFocusUp="@id/grid" />
    </LinearLayout>
    <LinearLayout android:id="@+id/blocked" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:background="#F20B1320" android:padding="64dp"
        android:focusable="true" android:focusableInTouchMode="true" android:visibility="gone">
        <TextView android:id="@+id/blocked_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/blocked_title" android:textColor="#FFFFFFFF" android:textSize="34sp" android:textStyle="bold" android:gravity="center" />
        <TextView android:id="@+id/blocked_body" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/blocked_body" android:textColor="#D9FFFFFF" android:textSize="18sp" android:gravity="center" android:layout_marginTop="16dp" />
    </LinearLayout>
</FrameLayout>
