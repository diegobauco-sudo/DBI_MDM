<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WiFly" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">#FF39D0C4</item>
        <item name="android:colorPrimary">#FF0B1320</item>
        <item name="android:colorPrimaryDark">#FF0B1320</item>
    </style>
    <style name="WiFly.Panel">
        <item name="android:windowBackground">@color/panel</item>
    </style>
    <style name="WiFly.Message">
        <item name="android:windowBackground">@color/clear</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.65</item>
    </style>
    <style name="Btn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/btn</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/btn</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textColorHint">#99FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
